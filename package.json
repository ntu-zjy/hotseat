{
  "name": "hotseat",
  "version": "0.1.0",
  "description": "Hand one task between AI coding agents (Claude Code, Codex, Cursor, Antigravity, WorkBuddy, Kimi and more) without re-explaining: a shared local task record via MCP, rules and hooks.",
  "keywords": [
    "mcp",
    "claude-code",
    "codex",
    "cursor",
    "antigravity",
    "ai-agents",
    "handoff",
    "context",
    "hooks",
    "workbuddy",
    "kimi"
  ],
  "homepage": "https://github.com/ntu-zjy/hotseat#readme",
  "bugs": {
    "url": "https://github.com/ntu-zjy/hotseat/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ntu-zjy/hotseat.git"
  },
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "hotseat": "dist/hotseat.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p .",
    "test": "npm run build && node --test \"src/**/*.test.ts\"",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7",
    "@types/node": "^22.19.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
